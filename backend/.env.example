# Copy to backend/.env. Never commit secrets. Set AI_PROVIDER=ollama for local AI.
AI_PROVIDER=test
AI_MODEL=qwen3:0.6b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_CONTEXT=2048
OLLAMA_OUTPUT=192
OLLAMA_THREADS=3
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=1m
PORT=8787
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4173
CHAT_ENABLED=true

# Optional absolute path to a trusted Stockfish 19 executable (local chess only).
# STOCKFISH_PATH=D:/CIC bot/CIC-bot/.tools/stockfish19/package/stockfish/stockfish-windows-x86-64-universal.exe
